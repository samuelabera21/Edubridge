# EduBridge Environment Configuration
# ⚠️  DO NOT edit this file directly.
# Run: bash setup.sh
# It will copy this file to .env and auto-fill the secrets for you.

POSTGRES_USER=edubridge_user
POSTGRES_PASSWORD=
POSTGRES_DB=edubridge
DB_PORT=5434
BACKEND_PORT=5001
FRONTEND_PORT=3001
BETTER_AUTH_SECRET=
DEFAULT_INITIAL_PASSWORD=

# ─── MinIO Object Storage ────────────────────────────────────────────────────
MINIO_ROOT_USER=edubridge_minio
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=edubridge-documents
# Public URL used by frontend to access uploaded files (must be browser-accessible)
MINIO_PUBLIC_URL=http://localhost:9000
