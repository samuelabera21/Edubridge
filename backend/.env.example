# ==============================================================================
# EduBridge Backend Environment Variables
# Copy this file to backend/.env and configure your local credentials.
# ==============================================================================

# ─── Database & Authentication ────────────────────────────────────────────────
# Connection URL to PostgreSQL database (port 5434 when running docker-compose)
DATABASE_URL="postgresql://edubridge_user:5BCB444994E2DBAB7BC83FA687BAEBED@localhost:5434/edubridge"

# Better Auth Secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="your-better-auth-secret-here"
BETTER_AUTH_URL="http://localhost:5000"

# Default administrative passwords
DEFAULT_INITIAL_PASSWORD="Admin@1234"
ADMIN_PASSWORD="Admin@1234"

# ─── Frontend & Networking ────────────────────────────────────────────────────
# The public URL where the Next.js frontend is running
FRONTEND_URL="http://localhost:3001"

# ─── Email Notification Services ─────────────────────────────────────────────
# Primary: Gmail SMTP
# (Generate an App Password at: https://myaccount.google.com/apppasswords)
SMTP_SERVICE="gmail"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
EMAIL_FROM="EduBridge Administrative System <Edubridge@gov.et>"

# Fallback: Resend API (https://resend.com)
RESEND_API_KEY="re_your_resend_api_key"

# ─── Google Forms API & Google Drive OAuth 2.0 ────────────────────────────────
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create or select an OAuth 2.0 Client ID (Application type: Web application)
# 3. Add Authorized JavaScript origins:
#      - http://localhost:3000
#      - http://localhost:3001
#      - http://localhost:5000
# 4. Add Authorized redirect URIs:
#      - http://localhost:3001/api/auth/callback/google (for Google Sign-In)
#      - http://localhost:5000/api/auth/callback/google (for direct API access)
#      - http://localhost:5000/api/data-requests/google-oauth/callback (for Google Forms)
# 5. Enable "Google Forms API" and "Google Drive API" in APIs & Services > Library
# 6. Add your/teammates' Google accounts to "OAuth consent screen > Test Users"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_AUTH_CALLBACK_URL="http://localhost:3001/api/auth/callback/google"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/data-requests/google-oauth/callback"

# Optional: Persisted tokens (automatically managed by backend/.google_tokens.json)
GOOGLE_REFRESH_TOKEN=""
GOOGLE_ACCESS_TOKEN=""

# ─── MinIO / S3 Storage Service ──────────────────────────────────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ROOT_USER="edubridge_minio"
MINIO_ROOT_PASSWORD="your-minio-root-password-here"
MINIO_BUCKET="edubridge-documents"
MINIO_PUBLIC_URL="http://localhost:9000"
