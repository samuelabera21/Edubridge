# ==============================================================================
# EduBridge Backend Environment Variables
# Copy this file to backend/.env and configure your local credentials.
# ==============================================================================

# Database & Authentication
DATABASE_URL="postgresql://edubridge_user:5BCB444994E2DBAB7BC83FA687BAEBED@localhost:5434/edubridge"

# Better Auth Secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="your-better-auth-secret-here"
BETTER_AUTH_URL="http://localhost:5000"

# Default administrative passwords
DEFAULT_INITIAL_PASSWORD="Admin@1234"
ADMIN_PASSWORD="Admin@1234"

# Frontend & Networking
FRONTEND_URL="http://localhost:3001"

# Email Notification Services
SMTP_SERVICE="gmail"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
EMAIL_FROM="EduBridge Administrative System <Edubridge@gov.et>"

# Fallback: Resend API (https://resend.com)
RESEND_API_KEY="re_your_resend_api_key"

# Google Forms API & Google Drive OAuth 2.0
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_AUTH_CALLBACK_URL="http://localhost:3001/api/auth/callback/google"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/data-requests/google-oauth/callback"

# Optional: Persisted tokens (automatically managed by backend/.google_tokens.json)
GOOGLE_REFRESH_TOKEN=""
GOOGLE_ACCESS_TOKEN=""

# Storage Service: MinIO (Local) or Cloudflare R2 (Production)
# Local Development (MinIO):
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ROOT_USER="edubridge_minio"
MINIO_ROOT_PASSWORD="your-minio-root-password-here"
MINIO_BUCKET="edubridge-documents"
MINIO_PUBLIC_URL="http://localhost:9000"

# Production (Cloudflare R2 - S3 compatible,  egress fees):
# When R2_ACCOUNT_ID is set, backend automatically routes to Cloudflare R2
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET="edubridge-documents"
# R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"

# Gemini AI Keys
# Higher-level administrative EMIS AI Analytics (Federal, Regional, Zone, Woreda, School Admin):
GEMINI_API_KEY="your-gemini-api-key"
# Dedicated Student AI Tutor Key (optional, protects higher-level quota; falls back to GEMINI_API_KEY if unset):
STUDENT_GEMINI_API_KEY="your-student-gemini-api-key"
