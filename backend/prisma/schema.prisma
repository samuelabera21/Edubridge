generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// BETTER AUTH — Authentication
// ============================================================

model User {
  id                   String                 @id
  name                 String
  email                String
  emailVerified        Boolean                @default(false)
  image                String?
  requiresPasswordChange Boolean              @default(false)
  isActive             Boolean                @default(true)
  observerObservations ClassroomObservation[] @relation("ObserverObservations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  roleAssignments    RoleAssignment[]
  auditLogs          AuditLog[]
  teacher            Teacher?
  parent             Parent?
  student            Student?
  studentAttendances StudentAttendance[]
  teacherAttendances TeacherAttendance[]
  studentResults     StudentResult[]
  supportFlags       SupportFlag[]
  announcements      Announcement[]
  notifications      Notification[]
  sentMessages       Message[]           @relation("SentMessages")
  receivedMessages   Message[]           @relation("ReceivedMessages")
  reportedIssues     Issue[]             @relation("ReportedIssues")
  assignedIssues     Issue[]             @relation("AssignedIssues")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id
  accountId  String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// EDUBRIDGE — Authorization Foundation
// ============================================================

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  permissions RolePermission[]
  assignments RoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RoleAssignment {
  id      String @id @default(cuid())
  userId  String
  roleId  String
  scopeId String

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scope OrganizationUnit @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId, scopeId])
  @@index([userId])
  @@index([roleId])
  @@index([scopeId])
}

model OrganizationUnit {
  id       String               @id @default(cuid())
  name     String
  type     OrganizationUnitType
  parentId String?

  parent   OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationHierarchy")

  assignments   RoleAssignment[]
  schoolProfile SchoolProfile?

  classroomObservations ClassroomObservation[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  academicYears      AcademicYear[]
  grades             Grade[]
  subjects           Subject[]
  auditLogs          AuditLog[]
  studentEnrollments StudentEnrollment[]
  teachers           Teacher[]
  classPeriods       ClassPeriod[]
  timetables         Timetable[]
  studentAttendances StudentAttendance[]
  teacherAttendances TeacherAttendance[]
  assessments        Assessment[]
  learningActivities LearningActivity[]
  supportFlags       SupportFlag[]
  announcements      Announcement[]
  resources          SchoolResource[]
  issues             Issue[]
  improvementPlans   ImprovementPlan[]
  timetableConfigs   TimetableConfig[]

  @@index([parentId])
  @@index([type])
}

enum OrganizationUnitType {
  FEDERAL
  REGION
  ZONE
  WOREDA
  SCHOOL
}

// ============================================================
// SCHOOL DOMAIN
// ============================================================

model SchoolProfile {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  establishedYear Int?
  contactEmail    String?
  phoneNumber     String?
  address         String?
  status          SchoolStatus @default(ACTIVE)
  configuration   Json?

  organization OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("school_profile")
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// ============================================================
// ACADEMIC FOUNDATION
// ============================================================

model AcademicYear {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         AcademicYearStatus @default(PLANNED)

  organization     OrganizationUnit  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolGrades     SchoolGrade[]
  schoolSubjects   SchoolSubject[]
  academicCalendar AcademicCalendar?

  classroomObservations ClassroomObservation[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  studentEnrollments  StudentEnrollment[]
  teachingAssignments TeachingAssignment[]
  timetables          Timetable[]
  studentAttendances  StudentAttendance[]
  teacherAttendances  TeacherAttendance[]
  assessments         Assessment[]
  learningActivities  LearningActivity[]
  timetableConfigs    TimetableConfig[]

  @@unique([organizationId, name])
  @@map("academic_year")
}

enum AcademicYearStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

model AcademicCalendar {
  id             String  @id @default(cuid())
  academicYearId String  @unique
  description    String?

  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  periods      AcademicPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_calendar")
}

model AcademicPeriod {
  id                 String   @id @default(cuid())
  academicCalendarId String
  name               String
  startDate          DateTime
  endDate            DateTime
  type               String // e.g. SEMESTER, TERM

  academicCalendar AcademicCalendar @relation(fields: [academicCalendarId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_period")
}

model Grade {
  id             String @id @default(cuid())
  organizationId String
  name           String
  level          Int

  organization OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolGrades SchoolGrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, level])
  @@unique([organizationId, name])
  @@map("grade")
}

model SchoolGrade {
  id             String @id @default(cuid())
  academicYearId String
  gradeId        String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade        Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  sections     Section[]

  classroomObservations ClassroomObservation[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  studentEnrollments  StudentEnrollment[]
  teachingAssignments TeachingAssignment[]

  @@unique([academicYearId, gradeId])
  @@map("school_grade")
}

model Section {
  id            String @id @default(cuid())
  schoolGradeId String
  name          String
  capacity      Int?

  schoolGrade SchoolGrade @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)

  classroomObservations ClassroomObservation[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  studentEnrollments  StudentEnrollment[]
  teachingAssignments TeachingAssignment[]

  @@unique([schoolGradeId, name])
  @@map("section")
}

model Subject {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String?

  organization   OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolSubjects SchoolSubject[]

  classroomObservations ClassroomObservation[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  teachingAssignments TeachingAssignment[]

  @@unique([organizationId, name])
  @@map("subject")
}

model SchoolSubject {
  id             String @id @default(cuid())
  academicYearId String
  subjectId      String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, subjectId])
  @@map("school_subject")
}

// ============================================================
// AUDIT FOUNDATION
// ============================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization OrganizationUnit? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([resource, resourceId])
  @@map("audit_log")
}

// ============================================================
// STUDENT DOMAIN
// ============================================================

model Student {
  id          String    @id @default(cuid())
  studentId   String    @unique
  userId      String?   @unique
  firstName   String
  lastName    String
  fatherName  String?
  grandfatherName String?
  dateOfBirth DateTime?
  gender      String?
  nationality String?
  placeOfBirth String?
  photoUrl    String?
  documents   Json?

  // Address
  region      String?
  zone        String?
  woreda      String?
  city        String?
  kebele      String?
  houseNumber String?

  // Previous School
  previousSchool    String?
  previousStudentId String?

  // Emergency Contact
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments StudentEnrollment[]
  parents     ParentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student")
}

model StudentEnrollment {
  id             String           @id @default(cuid())
  studentId      String
  organizationId String
  academicYearId String
  schoolGradeId  String
  sectionId      String?
  status         EnrollmentStatus @default(ENROLLED)
  enrollmentDate DateTime         @default(now())

  student       Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organization  OrganizationUnit       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  schoolGrade   SchoolGrade            @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  section       Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  statusHistory StudentStatusHistory[]
  attendances   StudentAttendance[]
  results       StudentResult[]
  submissions   Submission[]
  supportFlags  SupportFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, academicYearId])
  @@index([organizationId])
  @@index([schoolGradeId])
  @@map("student_enrollment")
}

model StudentStatusHistory {
  id           String           @id @default(cuid())
  enrollmentId String
  status       EnrollmentStatus
  reason       String?
  date         DateTime         @default(now())

  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_status_history")
}

enum EnrollmentStatus {
  ENROLLED
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  DROPPED_OUT
  GRADUATED
}

// ============================================================
// TEACHER DOMAIN
// ============================================================

model Teacher {
  id             String  @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  fatherName     String?
  grandfatherName String?
  employeeId     String? @unique
  userId         String? @unique
  
  gender         String?
  dateOfBirth    DateTime?
  qualification  String?
  fieldOfStudy   String?
  yearsOfExperience Int?
  
  phoneNumber    String?
  email          String?
  
  // Address
  region         String?
  zone           String?
  woreda         String?
  city           String?
  kebele         String?
  houseNumber    String?
  
  // Media & Documents
  photoUrl       String?
  documents      Json?
  
  status         String  @default("ACTIVE")
  availability   Json?

  organization OrganizationUnit     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments  TeachingAssignment[]
  attendances  TeacherAttendance[]

  classroomObservations ClassroomObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teacher")
}

model TeachingAssignment {
  id             String  @id @default(cuid())
  teacherId      String
  academicYearId String
  subjectId      String
  schoolGradeId  String
  sectionId      String?
  periodsPerWeek Int     @default(0)

  teacher            Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolGrade        SchoolGrade        @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  section            Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  timetables         Timetable[]
  assessments        Assessment[]
  learningActivities LearningActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A teacher should not be assigned the same exact class/subject twice in a year
  @@unique([teacherId, academicYearId, subjectId, sectionId])
  @@map("teaching_assignment")
}

// ============================================================
// PARENT DOMAIN
// ============================================================

model Parent {
  id          String  @id @default(cuid())
  userId      String? @unique
  firstName   String
  lastName    String
  phoneNumber String?
  email       String?

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  children ParentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parent")
}

model ParentStudent {
  id           String  @id @default(cuid())
  parentId     String
  studentId    String
  relationship String // e.g., "Mother", "Father", "Guardian"
  isPrimary    Boolean @default(true)
  canPickup    Boolean @default(true)

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, studentId])
  @@map("parent_student")
}

// ============================================================
// TEACHING STRUCTURE DOMAIN
// ============================================================

model ClassPeriod {
  id             String @id @default(cuid())
  organizationId String
  name           String // e.g. "Period 1"
  startTime      String // e.g. "08:00"
  endTime        String // e.g. "08:45"
  isBreak        Boolean @default(false)

  organization       OrganizationUnit    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timetables         Timetable[]
  studentAttendances StudentAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@map("class_period")
}

model Timetable {
  id                   String  @id @default(cuid())
  organizationId       String
  academicYearId       String
  teachingAssignmentId String
  classPeriodId        String
  dayOfWeek            Int // 0 = Sunday, 1 = Monday, etc.
  roomId               String? // Optional room assignment

  organization       OrganizationUnit   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  classPeriod        ClassPeriod        @relation(fields: [classPeriodId], references: [id], onDelete: Cascade)
  room               SchoolResource?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teachingAssignmentId, classPeriodId, dayOfWeek])
  @@index([organizationId])
  @@map("timetable")
}

// ============================================================
// ATTENDANCE DOMAIN
// ============================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model StudentAttendance {
  id             String           @id @default(cuid())
  organizationId String
  academicYearId String
  enrollmentId   String
  classPeriodId  String?
  date           DateTime         @db.Date
  status         AttendanceStatus
  remarks        String?
  recordedById   String?

  organization OrganizationUnit  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classPeriod  ClassPeriod?      @relation(fields: [classPeriodId], references: [id], onDelete: SetNull)
  recordedBy   User?             @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, date, classPeriodId])
  @@index([organizationId, date])
  @@map("student_attendance")
}

model TeacherAttendance {
  id             String           @id @default(cuid())
  organizationId String
  academicYearId String
  teacherId      String
  date           DateTime         @db.Date
  status         AttendanceStatus
  remarks        String?
  recordedById   String?

  organization OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  recordedBy   User?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, date])
  @@index([organizationId, date])
  @@map("teacher_attendance")
}

// ============================================================
// ASSESSMENT DOMAIN
// ============================================================

enum AssessmentType {
  EXAM
  QUIZ
  ASSIGNMENT
  PROJECT
  OTHER
}

model Assessment {
  id                   String         @id @default(cuid())
  organizationId       String
  academicYearId       String
  teachingAssignmentId String // Links back to the specific Subject+Section+Teacher
  title                String
  description          String?
  type                 AssessmentType @default(EXAM)
  maxScore             Float
  passingScore         Float?
  dueDate              DateTime?      @db.Date

  organization       OrganizationUnit   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  results            StudentResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([teachingAssignmentId])
  @@map("assessment")
}

model StudentResult {
  id           String  @id @default(cuid())
  assessmentId String
  enrollmentId String
  score        Float
  feedback     String?
  gradedById   String?

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  gradedBy   User?             @relation(fields: [gradedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, enrollmentId])
  @@map("student_result")
}

// ============================================================
// LEARNING & SUPPORT DOMAIN
// ============================================================

enum ActivityType {
  HOMEWORK
  READING
  LAB
  PRACTICE
}

model LearningActivity {
  id                   String       @id @default(cuid())
  organizationId       String
  academicYearId       String
  teachingAssignmentId String
  title                String
  description          String?
  type                 ActivityType @default(HOMEWORK)
  dueDate              DateTime?    @db.Date

  organization       OrganizationUnit   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  submissions        Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([teachingAssignmentId])
  @@map("learning_activity")
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

model Submission {
  id                 String           @id @default(cuid())
  learningActivityId String
  enrollmentId       String
  status             SubmissionStatus @default(PENDING)
  submittedAt        DateTime?
  contentUrl         String?
  grade              String?
  feedback           String?

  activity   LearningActivity  @relation(fields: [learningActivityId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([learningActivityId, enrollmentId])
  @@map("submission")
}

enum SupportFlagType {
  ACADEMIC
  BEHAVIORAL
  ATTENDANCE
  MEDICAL
  OTHER
}

model SupportFlag {
  id             String          @id @default(cuid())
  organizationId String
  enrollmentId   String
  type           SupportFlagType
  description    String
  raisedById     String?
  resolvedAt     DateTime?
  resolution     String?

  organization OrganizationUnit  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  raisedBy     User?             @relation(fields: [raisedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([enrollmentId])
  @@map("support_flag")
}

// ============================================================
// COMMUNICATION DOMAIN
// ============================================================

enum AnnouncementTarget {
  ALL
  TEACHERS
  STUDENTS
  PARENTS
  SPECIFIC_GRADE
  SPECIFIC_SECTION
}

model Announcement {
  id             String             @id @default(cuid())
  organizationId String
  title          String
  content        String
  target         AnnouncementTarget @default(ALL)
  targetId       String?
  authorId       String
  expiresAt      DateTime?          @db.Date

  organization OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([target])
  @@map("announcement")
}

model Notification {
  id      String  @id @default(cuid())
  userId  String
  title   String
  content String
  isRead  Boolean @default(false)
  link    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notification")
}

model Message {
  id         String  @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean @default(false)

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@map("message")
}

// ============================================================
// OPERATIONAL DOMAIN
// ============================================================

enum ResourceType {
  CLASSROOM
  LAB
  LIBRARY
  SPORTS_FACILITY
  EQUIPMENT
  OTHER
}

model SchoolResource {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           ResourceType @default(CLASSROOM)
  capacity       Int?
  status         String       @default("AVAILABLE")
  description    String?
  availability   Json?

  organization OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issues       Issue[]
  timetables   Timetable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("school_resource")
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Issue {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  description    String
  status         IssueStatus   @default(OPEN)
  priority       IssuePriority @default(MEDIUM)
  reportedById   String
  assignedToId   String?
  resourceId     String?

  organization OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy   User             @relation("ReportedIssues", fields: [reportedById], references: [id])
  assignedTo   User?            @relation("AssignedIssues", fields: [assignedToId], references: [id])
  resource     SchoolResource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("issue")
}

model ImprovementPlan {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String
  objectives     String
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  status         String    @default("PLANNED")

  organization OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("improvement_plan")
}

model ClassroomObservation {
  id             String  @id @default(cuid())
  organizationId String
  academicYearId String
  teacherId      String
  subjectId      String
  schoolGradeId  String
  sectionId      String?
  observerId     String

  date  DateTime
  topic String

  strengths       String? @db.Text
  weaknesses      String? @db.Text
  recommendations String? @db.Text
  feedback        String? @db.Text

  followUpAction String?   @db.Text
  followUpDate   DateTime?
  status         String    @default("SCHEDULED")

  organization OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolGrade  SchoolGrade      @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  section      Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  observer     User             @relation("ObserverObservations", fields: [observerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("classroom_observation")
}

model TimetableConfig {
  id             String           @id @default(cuid())
  organizationId String
  academicYearId String
  operatingDays  Json             // Array of numbers, e.g., [1,2,3,4,5] (Mon-Fri)
  startTime      String           // e.g., "08:00"
  periodDuration Int              // minutes, e.g., 40
  periodsPerDay  Int              // e.g., 6 or 8
  breakDuration  Int?             // short recess in minutes
  breakAfter     Int?             // period number after which break occurs
  lunchDuration  Int?             // lunch recess in minutes
  lunchAfter     Int?             // period number after which lunch occurs
  shift          String           // "FULL", "MORNING", "AFTERNOON"

  organization   OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, academicYearId])
  @@map("timetable_config")
}
