FROM node:22-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install --prefer-offline --fetch-retry-mintimeout 20000 --fetch-retry-maxtimeout 120000 --fetch-retries 5

COPY . .

EXPOSE 5000

# Run Prisma client generation at container start so runtime env vars (DATABASE_URL)
# provided by docker-compose are available. Then start the dev server.
CMD ["sh", "-c", "npx prisma generate && npm run dev"]
